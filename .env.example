# --- Required ---
DATABASE_URL=postgres://seedchain:seedchain@localhost:55432/seedchain_dev
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me
# Origin that is encoded into every printed QR (https in production)
PUBLIC_TRACE_BASE_URL=http://localhost:8080

# --- Server ---
PORT=8080
NODE_ENV=development
# Apply migrations automatically when the API boots (recommended for single-instance deploys)
RUN_MIGRATIONS_ON_START=true
# Serve the built SPA from the API (single-origin deployment)
FRONTEND_DIST_DIR=../seedchain/dist/public
# Set true behind HTTPS in production (default: true when NODE_ENV=production)
# COOKIE_SECURE=true
# TRUST_PROXY=1
# DATABASE_SSL=require
# CORS_ORIGINS=https://app.example.com   (only for split frontend/API deployments)

# --- External data (optional; never fabricated if absent) ---
# Free key from https://data.gov.in  (market prices ingestion is SKIPPED without it)
# DATA_GOV_IN_API_KEY=
# DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# MARKET_COMMODITY=Potato
# MARKET_INGEST_INTERVAL_MINUTES=360
# WEATHER_INGEST_INTERVAL_MINUTES=60
# INGESTION_ENABLED=true

# --- Legacy import only ---
# LEGACY_SESSION_SECRET=   (old SESSION_SECRET, needed to verify imported legacy passwords once)

# --- Online payments (Razorpay). Off until key id AND secret are set. See docs/PAYMENTS.md ---
# Use rzp_test_ keys first. The secret is server-only and is never sent to the browser.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=        (required in production when payments are on)
# PAYMENT_HOLD_MINUTES=20
